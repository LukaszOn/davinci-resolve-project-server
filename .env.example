# Choose a major version compatible with your DaVinci Resolve version. Recommended for new installs: 18.
# Changing the major version requires a data migration. See the version notes in the README.
POSTGRES_VERSION=18

# Required. Set separate strong passwords and the pgAdmin administrator email.
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Use the Docker host's LAN or VPN address for Resolve clients on other computers.
# Resolve clients connect to this address on TCP port 5432.
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_DB=database

# Leave blank for ./data/postgres-<major>. Set your own data directory on Unraid.
POSTGRES_DATA_DIR=
BACKUP_DIR=./backups
# Leave blank to use POSTGRES_DB. After creating libraries, enter their comma-separated names.
BACKUP_DATABASES=
TZ=UTC
BACKUP_SCHEDULE='30 2 * * *'
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# Address and port of the administration interface.
PGADMIN_BIND_IP=127.0.0.1
PGADMIN_PORT=3001

# Used only with compose.panel.yml.
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=3012
