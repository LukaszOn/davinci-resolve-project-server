# Wybierz główną wersję zgodną ze swoim DaVinci Resolve. Zalecana dla nowych instalacji: 18.
# Zmiana numeru nigdy nie migruje danych. Zobacz sekcję o wersjach w README.
POSTGRES_VERSION=18

# Wymagane. Ustaw osobne silne hasła i adres e-mail administratora pgAdmin.
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Zmień na lokalny adres LAN lub VPN hosta, jeśli Resolve działa na innym komputerze.
# Klienci Resolve łączą się z tym adresem na domyślnym porcie TCP 5432.
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_DB=database

# Puste oznacza katalog ./data/postgres-<wersja>. Dla Unraida podaj własny katalog danych.
POSTGRES_DATA_DIR=
BACKUP_DIR=./backups
# Puste oznacza POSTGRES_DB. Po utworzeniu bibliotek wpisz tu ich nazwy oddzielone przecinkiem.
BACKUP_DATABASES=
TZ=UTC
BACKUP_SCHEDULE='30 2 * * *'
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# Adres i port interfejsu administracyjnego.
PGADMIN_BIND_IP=127.0.0.1
PGADMIN_PORT=3001

# Używane tylko przy uruchomieniu compose.panel.yml.
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=3012
